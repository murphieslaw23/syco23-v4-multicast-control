{
  "name": "syco23-multicast-control",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx app/server/runtime-server.ts",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts,.vue",
    "typecheck": "vue-tsc --noEmit",
    "e2e": "playwright test",
    "security:audit": "npm audit --audit-level=high",
    "docker:build": "docker build -t syco23/multicast-control:local .",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "pm2:start": "npm run build && pm2 start ecosystem.config.cjs",
    "dev:ui": "vite",
    "dev:server": "tsx watch app/server/runtime-server.ts",
    "start": "tsx app/server/runtime-server.ts"
  },
  "dependencies": {
    "@types/sql.js": "^1.4.11",
    "hls.js": "^1.6.16",
    "sql.js": "^1.14.1",
    "vue": "^3.4.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.12.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.23.0",
    "jsdom": "^24.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.4.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^9.4.0",
    "vue-tsc": "^2.0.0",
    "wait-on": "^8.0.5"
  }
}
