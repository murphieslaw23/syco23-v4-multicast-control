# AzuraCast API Configuration
AZURACAST_API_URL=https://radio.syco23.de/api
AZURACAST_API_KEY=your-api-key-here

# SQLite Database
SQLITE_FILE=./data/syco23.sqlite

# Stream Configuration
STREAM_INGEST_URL=rtmp://ingest.syco23.de/live

# Control Runtime
HOST=0.0.0.0
PORT=3000
SYCO_DB_PATH=./data/syco23.sqlite
# Set a long random token in production. Leave empty only for trusted local networks.
SYCO_API_TOKEN=
# Optional custom FFmpeg executable path
FFMPEG_PATH=ffmpeg
