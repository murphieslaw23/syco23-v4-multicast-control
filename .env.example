# AzuraCast API Configuration
AZURACAST_API_URL=https://radio.syco23.de/api
AZURACAST_API_KEY=your-api-key-here

# SQLite Database
SQLITE_FILE=./data/syco23.sqlite

# Stream Configuration
STREAM_INGEST_URL=rtmp://ingest.syco23.de/live

# Control Runtime
HOST=0.0.0.0
PORT=3000
SYCO_DB_PATH=./data/syco23.sqlite
# Set a long random token in production. Leave empty only for trusted local networks.
SYCO_API_TOKEN=
# Optional custom FFmpeg executable path
FFMPEG_PATH=ffmpeg

# Role-based access tokens. SYCO_ADMIN_TOKEN falls back to SYCO_API_TOKEN.
SYCO_ADMIN_TOKEN=
SYCO_OPERATOR_TOKEN=
SYCO_VIEWER_TOKEN=
SYCO_BACKUP_DIR=./data/backups

# Watchdog runtime
SYCO_WATCHDOG_INTERVAL_MS=2000
SYCO_WATCHDOG_STARTUP_GRACE_MS=20000
SYCO_WATCHDOG_PROGRESS_TIMEOUT_MS=15000
SYCO_WATCHDOG_MAX_RESTARTS=3
SYCO_WATCHDOG_BACKOFF_MS=2000
SYCO_WATCHDOG_COOLDOWN_MS=60000

# AzuraCast metadata
SYCO_AZURACAST_URL=https://azura.example.org
SYCO_AZURACAST_STATION=1
SYCO_AZURACAST_API_KEY=
SYCO_METADATA_POLL_MS=15000
SYCO_METADATA_TIMEOUT_MS=5000
SYCO_METADATA_STALE_MS=60000
SYCO_METADATA_MAX_BACKOFF_MS=300000

# Per-destination FFmpeg worker recovery
SYCO_DESTINATION_MAX_RESTARTS=3
SYCO_DESTINATION_BACKOFF_MS=2000
SYCO_DESTINATION_COOLDOWN_MS=60000
