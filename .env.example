# Runtime identity
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Native SQLite durability (recommended and used by Docker)
SYCO_DB_DRIVER=native
SYCO_DB_PATH=./data/syco23.sqlite
SYCO_DATA_DIR=./data
SYCO_ASSET_DIR=./data/assets
SYCO_PREVIEW_DIR=./data/preview
SYCO_BACKUP_DIR=./data/backups

# Production authentication is fail-closed. Configure at least one mechanism.
# Recommended first boot: create the administrator account, then remove the password
# from the environment after the account has been persisted.
SYCO_BOOTSTRAP_ADMIN_USER=admin
SYCO_BOOTSTRAP_ADMIN_PASSWORD=
# Optional role tokens. SYCO_API_TOKEN is an administrator compatibility alias.
SYCO_ADMIN_TOKEN=
SYCO_OPERATOR_TOKEN=
SYCO_VIEWER_TOKEN=
SYCO_API_TOKEN=
SYCO_SESSION_TTL_MS=28800000
SYCO_RATE_LIMIT_CAPACITY=120
SYCO_RATE_LIMIT_REFILL_PER_SECOND=2

# Stream ingest and FFmpeg
STREAM_INGEST_URL=rtmp://ingest.example.org/live
FFMPEG_PATH=ffmpeg
SYCO_DESTINATION_MAX_RESTARTS=3
SYCO_DESTINATION_BACKOFF_MS=2000
SYCO_DESTINATION_COOLDOWN_MS=60000

# Watchdog runtime
SYCO_WATCHDOG_INTERVAL_MS=2000
SYCO_WATCHDOG_STARTUP_GRACE_MS=20000
SYCO_WATCHDOG_PROGRESS_TIMEOUT_MS=15000
SYCO_WATCHDOG_MAX_RESTARTS=3
SYCO_WATCHDOG_BACKOFF_MS=2000
SYCO_WATCHDOG_COOLDOWN_MS=60000

# AzuraCast metadata
SYCO_AZURACAST_URL=https://azura.example.org
SYCO_AZURACAST_STATION=1
SYCO_AZURACAST_API_KEY=
SYCO_METADATA_POLL_MS=15000
SYCO_METADATA_TIMEOUT_MS=5000
SYCO_METADATA_STALE_MS=60000
SYCO_METADATA_MAX_BACKOFF_MS=300000

# Local authenticated HLS preview
SYCO_PREVIEW_WIDTH=1280
SYCO_PREVIEW_HEIGHT=720
SYCO_PREVIEW_FPS=25
SYCO_PREVIEW_VIDEO_BITRATE=1800
SYCO_PREVIEW_AUDIO_BITRATE=128
SYCO_PREVIEW_SEGMENT_SECONDS=2
SYCO_PREVIEW_LIST_SIZE=6

# Provider acknowledgement, playback and metadata publishing
SYCO_PROVIDER_PROBE_INTERVAL_MS=15000
SYCO_PROVIDER_PROBE_TIMEOUT_MS=5000
# Provider bearer credentials are referenced by each destination through
# providerApiSecretRef, for example env:YOUTUBE_API_TOKEN or a file below
# /run/secrets/. Never persist provider credentials in destination records.

# Retention and command safety
SYCO_IDEMPOTENCY_TTL_MS=300000
SYCO_RETENTION_INTERVAL_MS=3600000
SYCO_RETENTION_LOG_DAYS=30
SYCO_RETENTION_AUDIT_DAYS=365
SYCO_RETENTION_INCIDENT_DAYS=180
SYCO_RETENTION_METADATA_DAYS=30
SYCO_RETENTION_WORKER_EVENT_DAYS=30
SYCO_RETENTION_PROVIDER_EVENT_DAYS=30
SYCO_RETENTION_WATCHDOG_EVENT_DAYS=90
